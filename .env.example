# Neon connection string (Neon dashboard -> Connect -> copy the connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Any long random text. Used to sign login sessions.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars

# Where the web app runs (the api trusts requests from here)
WEB_ORIGIN=http://localhost:5173
API_PORT=3001
