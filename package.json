{
  "name": "hinton-expenses",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @hinton/api --filter @hinton/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @hinton/db generate",
    "db:migrate": "pnpm --filter @hinton/db migrate",
    "db:seed": "pnpm --filter @hinton/db seed"
  },
  "packageManager": "pnpm@10.32.1"
}
